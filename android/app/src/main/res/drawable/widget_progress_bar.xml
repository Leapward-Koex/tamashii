<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="@color/widget_track" /><corners android:radius="24dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:gravity="start" android:clipOrientation="horizontal">
            <shape><solid android:color="@color/widget_progress" /><corners android:radius="24dp" /></shape>
        </clip>
    </item>
</layer-list>
