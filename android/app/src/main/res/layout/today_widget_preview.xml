<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical"
    android:background="@drawable/widget_surface" android:padding="14dp" android:orientation="vertical">
    <TextView android:id="@+id/widget_title" style="@style/WidgetMasthead" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:drawableStart="@drawable/widget_calendar" android:drawablePadding="8dp" android:gravity="center_vertical"
        android:text="@string/today_widget_title" />
    <ImageView style="@style/WidgetRule" android:layout_marginTop="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_series" style="@style/WidgetShowTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/today_widget_preview_show" />
            <TextView android:id="@+id/widget_subtitle" style="@style/WidgetEpisode" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/today_widget_preview_episode" />
        </LinearLayout>
        <TextView android:id="@+id/widget_button_label" android:layout_width="100dp" android:layout_height="48dp" android:background="@drawable/widget_action"
            android:text="@string/today_widget_download" android:textColor="@color/widget_surface" android:textStyle="bold" android:gravity="center" />
    </LinearLayout>
</LinearLayout>
