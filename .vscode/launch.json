    "version": "0.2.0",
    "configurations": [
        {
            "name": "tamashii",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=TAMASHII_USE_TEST_TORRENT=true"
            ]
        },
        {
            "name": "tamashii (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define=TAMASHII_USE_TEST_TORRENT=true"
            ]
        },
        {
            "name": "tamashii (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define=TAMASHII_USE_TEST_TORRENT=true"
            ]
        }
    ]
}
